#!/usr/bin/env python3
"""
Network Profile Manager for Fedora Workstation.
Manages switching network profiles, routing gateways, DNS servers, and Tailscale.

Profiles:
- Estonia VPN (Route .1 + VPN + EET)
- Finland VPN (Route .1 + VPN + EET)
- Route .1 + Tailscale (Direct Gateway + Tailscale + WIB)
- Route .1 without VPN (Direct Gateway + Tailscale Down + WIB)
- Local .100 Profile (Repeater Gateway + Tailscale + WIB)

DNS Options:
- 192.168.123.1 (Direct Fiber Router)
- 192.168.123.100 (Repeater Hop)
- 100.100.100.100 (Tailscale MagicDNS)
- 1.1.1.1 (Cloudflare)
- 8.8.8.8 (Google)
"""

import sys
import os
import json
import subprocess

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=25)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return 1, "", str(e)

def get_default_interface():
    rc, out, _ = run_cmd("ip route show default")
    if rc == 0 and out:
        words = out.split()
        if "dev" in words:
            idx = words.index("dev")
            if idx + 1 < len(words):
                return words[idx + 1]
    return "wlp3s0"

def get_dns_servers():
    dns_entries = []
    rc, out, _ = run_cmd("resolvectl dns")
    if rc == 0 and out:
        for line in out.splitlines():
            line = line.strip()
            if ":" in line:
                parts = line.split(":", 1)
                link_name = parts[0].strip()
                servers = parts[1].strip()
                if servers:
                    clean_link = link_name.split("(")[-1].replace(")", "").strip()
                    dns_entries.append(f"{servers} ({clean_link})")
    if not dns_entries:
        try:
            with open("/etc/resolv.conf") as f:
                for line in f:
                    if line.startswith("nameserver"):
                        dns_entries.append(line.split()[1])
        except Exception:
            pass
    return ", ".join(dns_entries) if dns_entries else "Unknown"

def get_status():
    status = {
        "profile": "unknown",
        "label": "Unknown",
        "short_label": "Net: ...",
        "icon": "network-workgroup-symbolic",
        "route_gateway": "unknown",
        "gateway_ip": "unknown",
        "interface": get_default_interface(),
        "nordvpn_status": "Disconnected",
        "nordvpn_country": None,
        "nordvpn_server": None,
        "nordvpn_ip": None,
        "tailscale_up": False,
        "timezone": "unknown",
        "dns": get_dns_servers()
    }

    # 1. Route gateway
    _, out, _ = run_cmd("ip route show default")
    if "via 192.168.123.1 " in out or "via 192.168.123.1\n" in out or out.startswith("default via 192.168.123.1"):
        status["gateway_ip"] = "192.168.123.1"
        status["route_gateway"] = "192.168.123.1 (Direct Fiber)"
    elif "via 192.168.123.100" in out:
        status["gateway_ip"] = "192.168.123.100"
        status["route_gateway"] = "192.168.123.100 (Repeater Hop)"
    else:
        first_line = out.split("\n")[0] if out else "Unknown"
        status["route_gateway"] = first_line

    # 2. NordVPN
    _, out, _ = run_cmd("nordvpn status")
    if "Status: Connected" in out:
        status["nordvpn_status"] = "Connected"
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("Country:"):
                status["nordvpn_country"] = line.split(":", 1)[1].strip()
            elif line.startswith("Current server:"):
                status["nordvpn_server"] = line.split(":", 1)[1].strip()
            elif line.startswith("Your new IP:") or line.startswith("Your IP:") or line.startswith("IP:"):
                status["nordvpn_ip"] = line.split(":", 1)[1].strip()
    else:
        status["nordvpn_status"] = "Disconnected"

    # 3. Tailscale
    _, out, _ = run_cmd("tailscale status")
    if "Tailscale is stopped" in out or "Logged out" in out or not out:
        status["tailscale_up"] = False
    else:
        status["tailscale_up"] = True

    # 4. Timezone
    _, out, _ = run_cmd("timedatectl show -p Timezone --value")
    status["timezone"] = out.strip() if out else "Unknown"

    # 5. Determine Active Profile & Labels
    if status["nordvpn_status"] == "Connected":
        c = (status["nordvpn_country"] or "").lower()
        if "estonia" in c or "tallinn" in status["timezone"].lower():
            status["profile"] = "estonia"
            status["label"] = "🇪🇪 Estonia (VPN)"
            status["short_label"] = "🇪🇪 EE"
            status["icon"] = "network-vpn-symbolic"
        elif "finland" in c or "helsinki" in status["timezone"].lower():
            status["profile"] = "finland"
            status["label"] = "🇫🇮 Finland (VPN)"
            status["short_label"] = "🇫🇮 FI"
            status["icon"] = "network-vpn-symbolic"
        else:
            status["profile"] = "vpn_other"
            status["label"] = f"🛡️ {status['nordvpn_country'] or 'VPN'}"
            status["short_label"] = "🛡️ VPN"
            status["icon"] = "network-vpn-symbolic"
    else:
        if status["gateway_ip"] == "192.168.123.1":
            if status["tailscale_up"]:
                status["profile"] = "direct_ts"
                status["label"] = "⚡ Direct (.1) + Tailscale"
                status["short_label"] = "⚡ .1 + TS"
                status["icon"] = "network-wireless-symbolic"
            else:
                status["profile"] = "direct_novpn"
                status["label"] = "⚡ Direct (.1) No VPN"
                status["short_label"] = "⚡ .1 Clean"
                status["icon"] = "network-wireless-symbolic"
        elif status["gateway_ip"] == "192.168.123.100":
            status["profile"] = "local"
            status["label"] = "🏠 Local (.100)"
            status["short_label"] = "🏠 Local"
            status["icon"] = "network-workgroup-symbolic"
        else:
            status["profile"] = "custom"
            status["label"] = "⚙️ Custom"
            status["short_label"] = "⚙️ Net"
            status["icon"] = "network-workgroup-symbolic"

    return status

def set_profile_estonia():
    cmds = [
        "sudo ip route replace default via 192.168.123.1 dev wlp3s0",
        "sudo tailscale down",
        "nordvpn connect Estonia",
        "sudo timedatectl set-timezone Europe/Tallinn"
    ]
    for c in cmds:
        run_cmd(c)
    return get_status()

def set_profile_finland():
    cmds = [
        "sudo ip route replace default via 192.168.123.1 dev wlp3s0",
        "sudo tailscale down",
        "nordvpn connect Finland",
        "sudo timedatectl set-timezone Europe/Helsinki"
    ]
    for c in cmds:
        run_cmd(c)
    return get_status()

def set_profile_direct_ts():
    cmds = [
        "nordvpn disconnect",
        "sudo ip route replace default via 192.168.123.1 dev wlp3s0",
        "sudo timedatectl set-timezone Asia/Jakarta",
        "sudo tailscale up --exit-node-allow-lan-access=true"
    ]
    for c in cmds:
        run_cmd(c)
    return get_status()

def set_profile_direct_novpn():
    cmds = [
        "nordvpn disconnect",
        "sudo ip route replace default via 192.168.123.1 dev wlp3s0",
        "sudo tailscale down",
        "sudo timedatectl set-timezone Asia/Jakarta"
    ]
    for c in cmds:
        run_cmd(c)
    return get_status()

def set_profile_local():
    cmds = [
        "nordvpn disconnect",
        "sudo ip route replace default via 192.168.123.100 dev wlp3s0",
        "sudo timedatectl set-timezone Asia/Jakarta",
        "sudo tailscale up --exit-node-allow-lan-access=true"
    ]
    for c in cmds:
        run_cmd(c)
    return get_status()

def set_dns(dns_target):
    iface = get_default_interface()
    target = dns_target.strip().lower()
    
    if target in ("1", "192.168.123.1", ".1", "direct"):
        dns_ips = "192.168.123.1"
    elif target in ("100", "192.168.123.100", ".100", "repeater", "local"):
        dns_ips = "192.168.123.100"
    elif target in ("100.100.100.100", "magicdns", "tailscale", "ts"):
        dns_ips = "100.100.100.100"
    elif target in ("1.1.1.1", "cloudflare", "cf"):
        dns_ips = "1.1.1.1 1.0.0.1"
    elif target in ("8.8.8.8", "google", "goog"):
        dns_ips = "8.8.8.8 8.8.4.4"
    else:
        dns_ips = dns_target

    run_cmd(f"sudo resolvectl dns {iface} {dns_ips}")
    run_cmd("sudo resolvectl flush-caches")
    return get_status()

def launch_chrome(tz=None):
    env_flag = f"--env=TZ={tz} " if tz else ""
    cmd = f"flatpak run {env_flag}com.google.ChromeDev &"
    subprocess.Popen(cmd, shell=True)
    return {"status": "launched", "timezone": tz or "default"}

def main():
    args = sys.argv[1:]
    wants_json = False

    filtered_args = []
    for a in args:
        if a in ("--json", "-j"):
            wants_json = True
        else:
            filtered_args.append(a)

    cmd = filtered_args[0].lower() if filtered_args else "status"

    if cmd in ("estonia", "ee"):
        res = set_profile_estonia()
    elif cmd in ("finland", "fi"):
        res = set_profile_finland()
    elif cmd in ("direct-ts", "direct_ts", "route1-ts", "direct-tailscale"):
        res = set_profile_direct_ts()
    elif cmd in ("direct-novpn", "direct_novpn", "route1-novpn", "direct-clean"):
        res = set_profile_direct_novpn()
    elif cmd in ("local", "normal", "repeater", "100"):
        res = set_profile_local()
    elif cmd == "dns":
        target = filtered_args[1] if len(filtered_args) > 1 else "1.1.1.1"
        res = set_dns(target)
    elif cmd == "chrome":
        tz = None
        if len(filtered_args) > 1:
            tz = filtered_args[1].replace("--tz=", "").replace("--tz", "")
            if len(filtered_args) > 2 and not tz:
                tz = filtered_args[2]
        res = launch_chrome(tz)
    else:
        res = get_status()

    if wants_json or len(args) == 0:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(f"Active Profile: {res.get('label', 'Unknown')}")
        print(f"Gateway:        {res.get('route_gateway')}")
        print(f"DNS Server(s):  {res.get('dns')}")
        print(f"NordVPN:        {res.get('nordvpn_status')} ({res.get('nordvpn_server') or 'None'})")
        print(f"Tailscale:      {'Connected' if res.get('tailscale_up') else 'Stopped'}")
        print(f"Timezone:       {res.get('timezone')}")

if __name__ == "__main__":
    main()
